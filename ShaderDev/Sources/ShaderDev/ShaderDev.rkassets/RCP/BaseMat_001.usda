def Xform "Preview"
{
    reorder nameChildren = ["SM_Glass", "SM_Tp_Plastic", "SM_Rubber", "SM_PET_Plastic", "SM_Chrome"]
    def Capsule "SM_Glass" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.2
        rel material:binding = </BaseMaterials/M_Glass> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.1
    }

